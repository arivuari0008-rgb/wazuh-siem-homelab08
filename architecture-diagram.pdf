<svg viewBox="0 0 900 560" xmlns="http://www.w3.org/2000/svg" font-family="Arial, Helvetica, sans-serif">
  <rect width="900" height="560" fill="#ffffff"/>
  <text x="450" y="40" text-anchor="middle" font-size="22" font-weight="bold" fill="#1f1f1f">Wazuh SIEM Home Lab — Network Architecture</text>
  <rect x="60" y="80" width="780" height="400" rx="10" fill="none" stroke="#888888" stroke-width="2" stroke-dasharray="6,4"/>
  <text x="80" y="105" font-size="14" fill="#666666">Isolated Lab Network (VirtualBox, segmented)</text>
  <rect x="370" y="130" width="160" height="70" rx="6" fill="#2e5f8a"/>
  <text x="450" y="160" text-anchor="middle" font-size="14" fill="#ffffff" font-weight="bold">Wazuh Manager</text>
  <text x="450" y="180" text-anchor="middle" font-size="11" fill="#dbe8f5">SIEM / Log Correlation</text>
  <rect x="110" y="290" width="170" height="70" rx="6" fill="#3d7a4f"/>
  <text x="195" y="318" text-anchor="middle" font-size="13" fill="#ffffff" font-weight="bold">Agent — Ubuntu/Debian</text>
  <text x="195" y="336" text-anchor="middle" font-size="11" fill="#dcefe1">Static IP · syslog UDP/514</text>
  <rect x="365" y="290" width="170" height="70" rx="6" fill="#3d7a4f"/>
  <text x="450" y="318" text-anchor="middle" font-size="13" fill="#ffffff" font-weight="bold">Agent — CentOS/RHEL</text>
  <text x="450" y="336" text-anchor="middle" font-size="11" fill="#dcefe1">Static IP · syslog UDP/514</text>
  <rect x="620" y="290" width="170" height="70" rx="6" fill="#a13d3d"/>
  <text x="705" y="318" text-anchor="middle" font-size="13" fill="#ffffff" font-weight="bold">Monitored Host</text>
  <text x="705" y="336" text-anchor="middle" font-size="11" fill="#f5dcdc">No internet access (isolated)</text>
  <line x1="450" y1="200" x2="195" y2="290" stroke="#555555" stroke-width="1.5"/>
  <line x1="450" y1="200" x2="450" y2="290" stroke="#555555" stroke-width="1.5"/>
  <line x1="450" y1="200" x2="705" y2="290" stroke="#555555" stroke-width="1.5"/>
  <rect x="110" y="410" width="230" height="55" rx="6" fill="#eeeeee" stroke="#999999"/>
  <text x="225" y="433" text-anchor="middle" font-size="12" fill="#333333" font-weight="bold">tcpdump packet analysis</text>
  <text x="225" y="450" text-anchor="middle" font-size="10" fill="#555555">used for log-forwarding triage</text>
  <rect x="360" y="410" width="230" height="55" rx="6" fill="#eeeeee" stroke="#999999"/>
  <text x="475" y="433" text-anchor="middle" font-size="12" fill="#333333" font-weight="bold">iptables / firewall auditing</text>
  <text x="475" y="450" text-anchor="middle" font-size="10" fill="#555555">connectivity + rule checks</text>
  <rect x="610" y="410" width="190" height="55" rx="6" fill="#eeeeee" stroke="#999999"/>
  <text x="705" y="433" text-anchor="middle" font-size="12" fill="#333333" font-weight="bold">Key-based agent enrollment</text>
  <text x="705" y="450" text-anchor="middle" font-size="10" fill="#555555">manual, cross-version fix</text>
</svg>


